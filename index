/* ---------- render - */
const tabbar = document.getElementById('tabbar');
const main = document.getElementById('main');
const receiptList = document.getElementById('receiptList');

let totalItems = 0;

PROGRAM.forEach(cat => {
  // tab button
  const tab = document.createElement('button');
  tab.className = 'tab-btn';
  tab.textContent = cat.name;
  tab.dataset.target = cat.id;
  tab.addEventListener('click', () => {
    document.getElementById('sec-' + cat.id).scrollIntoView({behavior:'smooth', block:'start'});
  });
  tabbar.appendChild(tab);

  // section
  const section = document.createElement('section');
  section.className = 'category-section';
  section.id = 'sec-' + cat.id;
  section.innerHTML = `
    <div class="category-head">
      <div class="category-name">${cat.name}</div>
      <div class="category-sub">${cat.sub}</div>
    </div>
  `;

  // 節目單裡只列分類大標題，不列出詳細曲目
  const receiptCat = document.createElement('div');
  receiptCat.className = 'receipt-cat';
  receiptCat.textContent = cat.name;
  receiptList.appendChild(receiptCat);

  cat.items.forEach(item => {
    if (!item.hidden) totalItems++;

    const card = document.createElement('div');
    card.className = 'item-card';
    if (item.isNote) {
  card.innerHTML = `<div class="item-note">${item.note}</div>`;
} else {
  card.innerHTML = `
    <div class="item-title">${item.title}</div>
    <div class="item-composer">${item.composer}</div>
    <div class="item-note">${item.note}</div>
  `;
}
    section.appendChild(card);
  });

  main.appendChild(section);
});

document.getElementById('orderTotalCount').textContent = `已點 ${totalItems} 首`;
document.getElementById('receiptTotal').textContent = `${totalItems} 首`;
document.getElementById('receiptMeta').textContent = `全場 ${totalItems} 首`;
document.getElementById('chefNote').textContent = CHEF_NOTE;

/* ---------- active tab highlight on scroll ---------- */
const tabButtons = Array.from(document.querySelectorAll('.tab-btn'));
const sections = PROGRAM.map(c => document.getElementById('sec-' + c.id));

const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      const id = entry.target.id.replace('sec-', '');
      tabButtons.forEach(b => b.classList.toggle('active', b.dataset.target === id));

      const activeTab = tabButtons.find(b => b.dataset.target === id);
      if (activeTab) {
        activeTab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      }
    }
  });
}, { rootMargin: '-40% 0px -55% 0px', threshold: 0 });

sections.forEach(s => observer.observe(s));
if (tabButtons[0]) tabButtons[0].classList.add('active');

/* ---------- receipt drawer ---------- */
const receipt = document.getElementById('receipt');
const backdrop = document.getElementById('backdrop');
const orderView = document.getElementById('orderView');
const confirmView = document.getElementById('confirmView');

function openReceipt(){
  receipt.classList.add('open');
  backdrop.classList.add('open');
}
function closeReceipt(){
  receipt.classList.remove('open');
  backdrop.classList.remove('open');
  // 收起後重置成一般節目單畫面，下次打開才會從頭開始
  orderView.style.display = 'block';
  confirmView.classList.remove('show');
}
document.getElementById('openReceipt').addEventListener('click', openReceipt);
document.getElementById('closeReceipt').addEventListener('click', closeReceipt);

/* ---------- performer info modal ---------- */
const performerModal = document.getElementById('performerModal');

function closePerformerModal(){
  performerModal.classList.remove('open');
  backdrop.classList.remove('open');
}

document.querySelectorAll('.performer-link').forEach(el => {
  el.addEventListener('click', () => {
    const p = PERFORMERS[el.dataset.performer];
    if (!p) return;
    document.getElementById('performerName').textContent = p.name;
    document.getElementById('performerRole').textContent = p.role;
    document.getElementById('performerBio').textContent = p.bio;
    performerModal.classList.add('open');
    backdrop.classList.add('open');
  });
});
document.getElementById('closePerformer').addEventListener('click', closePerformerModal);

// 背景遮罩是兩種彈窗共用的，點擊時要把「目前開著的那個」關掉
backdrop.addEventListener('click', () => {
  closeReceipt();
  closePerformerModal();
});

/* ---------- 送出訂單彩蛋：顯示演出者留言，再回到菜單瀏覽 ---------- */
document.getElementById('submitOrder').addEventListener('click', () => {
  orderView.style.display = 'none';
  confirmView.classList.add('show');
});
document.getElementById('backToMenu').addEventListener('click', () => {
  closeReceipt(); // 收起抽屜，回到原本瀏覽節目冊的畫面
});
</script>

